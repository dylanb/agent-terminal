{
  "name": "agent-terminal",
  "version": "0.1.0",
  "description": "Foundation for a coding-agent management application: bash in a PTY, xterm.js UI, shadow screen model, monitor pane",
  "homepage": "https://github.com/dylanb",
  "author": {
    "name": "Dylan Barrell",
    "email": "dylan@barrell.com"
  },
  "desktopName": "agent-terminal.desktop",
  "main": "out/main/index.js",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "rebuild": "electron-rebuild -f -w node-pty",
    "gen-icon": "node scripts/gen-icon.mjs",
    "postinstall": "electron-rebuild -f -w node-pty && node scripts/postinstall-sign.mjs",
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "package": "pnpm run gen-icon && pnpm run build && electron-builder"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "5.5.0",
    "codemirror": "^6.0.2",
    "js-yaml": "^4.2.0",
    "markdown-it": "^14.2.0",
    "mermaid": "^11.15.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
