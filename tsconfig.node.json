{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/selectionModel.ts",
    "src/renderer/src/selection.ts",
    "src/renderer/src/reveal.ts",
    "src/renderer/src/keymap.ts",
    "src/renderer/src/keymapController.ts",
    "src/renderer/src/keyboardSettings.ts",
    "src/renderer/src/cliInstall.ts",
    "src/renderer/src/installExamples.ts",
    "src/renderer/src/menuActions.ts",
    "src/renderer/src/dom.ts",
    "src/renderer/src/visibility.ts",
    "src/renderer/src/repoContext.ts",
    "src/renderer/src/paneActions.ts",
    "src/renderer/src/statusStrip.ts",
    "src/renderer/src/todoTab.ts",
    "src/renderer/src/captureTab.ts",
    "src/renderer/src/monitor.ts",
    "src/renderer/src/shell.ts",
    "src/renderer/src/crossHighlight.ts",
    "src/renderer/src/flowStrip.ts",
    "src/renderer/src/loopStatus.ts",
    "src/renderer/src/spinner.ts",
    "src/renderer/src/loopPanel.ts",
    "src/renderer/src/dockedPanelSync.ts",
    "src/renderer/src/statusBar.ts",
    "src/renderer/src/loopReveal.ts",
    "src/renderer/src/flowInputModal.ts",
    "src/renderer/src/feedbackComposer.ts",
    "src/renderer/src/redoComposer.ts",
    "src/renderer/src/wireAppBootstrapConflict.ts",
    "src/renderer/src/wireEpicPromotion.ts",
    "src/renderer/src/modalShell.ts",
    "src/renderer/src/confirmDialog.ts",
    "src/renderer/src/errorDialog.ts",
    "src/renderer/src/flowModalCoordinator.ts",
    "src/renderer/src/terminateConfirm.ts",
    "src/renderer/src/artifacts.ts",
    "src/renderer/src/viewerRender.ts",
    "src/renderer/src/terminal.ts",
    "src/renderer/src/env.d.ts",
    "electron.vite.config.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/fixtures/**/*.ts",
    "tests/helpers/**/*.ts",
    "tests/e2e/**/*.ts",
    "playwright.config.ts",
    "playwright.workers.ts",
    "vitest.config.ts",
    "vitest.poolSizing.ts"
  ]
}
